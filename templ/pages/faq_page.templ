package pages

import (
	"ego/templ/components"
	"ego/templ/layouts"
)

templ FaqPage() {
	@layouts.PublicLayout("FAQ — Pertanyaan Umum", faqContent())
}

templ faqContent() {
	<section class="min-h-screen bg-white pt-24 pb-16">
		<div class="container">
			<div style="max-width:768px;margin:0 auto;">
			<div class="text-center mb-12 fade-in-up">
				<div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-[var(--accent-200)] bg-[var(--accent-50)] text-xs font-medium text-[var(--accent-600)] mb-4 transition-all duration-300 hover:shadow-sm">
					<span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-500)]"></span>
					Informasi
				</div>
				<h1 class="text-3xl md:text-4xl font-bold tracking-tight text-[var(--textMain)] m-0">
					Pertanyaan <span class="text-accent">Umum</span>
				</h1>
				<p class="mt-3 text-[var(--textMuted)] m-0 max-w-md mx-auto">
					Semua yang perlu kamu tahu sebelum memulai tes kemampuan kognitif.
				</p>
			</div>

			<div class="card card-hover p-8 fade-in-up">
				@components.FaqSection()
			</div>
			</div>
		</div>
	</section>
}
