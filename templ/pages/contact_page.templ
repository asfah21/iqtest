package pages

import (
	"ego/templ/layouts"
)

templ ContactPage() {
	@layouts.PublicLayout("Kontak", contactContent())
}

templ contactContent() {
	<section class="min-h-screen bg-white pt-24 pb-16">
		<div class="container">
			<div style="max-width:768px;margin:0 auto;">
			<div class="text-center mb-12 fade-in-up">
				<div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-[var(--accent-200)] bg-[var(--accent-50)] text-xs font-medium text-[var(--accent-600)] mb-4 transition-all duration-300 hover:shadow-sm">
					<span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-500)]"></span>
					Informasi
				</div>
				<h1 class="text-3xl md:text-4xl font-bold tracking-tight text-[var(--textMain)] m-0">
					Hubungi <span class="text-accent">Kami</span>
				</h1>
				<p class="mt-3 text-[var(--textMuted)] m-0 max-w-md mx-auto">
					Punya pertanyaan, masukan, atau butuh bantuan? Kami siap membantu Anda.
				</p>
			</div>

			<div class="space-y-4">
				<div class="card card-hover p-8 fade-in-up">
					<div class="flex items-start gap-4">
						<div class="w-12 h-12 rounded-2xl bg-[var(--accent-50)] flex items-center justify-center flex-shrink-0">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--accent-500)]"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
						</div>
						<div>
							<h3 class="text-lg font-bold text-[var(--textMain)] m-0">Email Support</h3>
							<p class="mt-2 text-sm text-[var(--textMuted)] leading-relaxed m-0">
								Untuk pertanyaan umum, bantuan teknis, masalah pembayaran, permintaan data, atau masukan apa pun, silakan kirim email ke alamat resmi kami:
							</p>
							<p class="mt-3">
								<a href="mailto:support@iqtest.id" class="inline-flex items-center gap-2 px-4 py-3 bg-[var(--accent-50)] rounded-xl text-accent font-semibold hover:bg-[var(--accent-100)] transition-colors duration-200">
									<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
									support@iqtest.id
								</a>
							</p>
							<p class="mt-2 text-xs text-[var(--textMuted)]">
								Kami berusaha merespons semua email dalam 1×24 jam pada hari kerja (Senin–Jumat, pkl 09.00–17.00 WIB). Untuk email yang masuk di akhir pekan atau hari libur nasional, akan direspons pada hari kerja berikutnya.
							</p>
						</div>
					</div>
				</div>

				<div class="card card-hover p-8 fade-in-up" style="animation-delay:0.08s;">
					<div class="flex items-start gap-4">
						<div class="w-12 h-12 rounded-2xl bg-[var(--success-light)] flex items-center justify-center flex-shrink-0">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--success)]"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
						</div>
						<div>
							<h3 class="text-lg font-bold text-[var(--textMain)] m-0">Sebelum Menghubungi Kami</h3>
							<p class="mt-2 text-sm text-[var(--textMuted)] leading-relaxed m-0">
								Untuk mendapatkan respons yang lebih cepat, kami sarankan Anda memeriksa sumber daya berikut terlebih dahulu sebelum mengirim email — kemungkinan besar pertanyaan Anda sudah terjawab:
							</p>
							<ul class="mt-2 text-sm text-[var(--textMuted)] leading-relaxed space-y-1 list-disc pl-5">
								<li><strong><a href="/faq" class="text-accent hover:underline">Halaman FAQ</a></strong> — Jawaban atas pertanyaan yang paling sering ditanyakan, termasuk cara memulai tes, cara mengakses hasil, metode pembayaran, dan masalah teknis umum.</li>
								<li><strong><a href="/terms" class="text-accent hover:underline">Syarat & Ketentuan</a></strong> — Aturan penggunaan Platform, hak dan kewajiban Anda sebagai pengguna, serta ketentuan hukum yang mengatur layanan kami.</li>
								<li><strong><a href="/privacy" class="text-accent hover:underline">Kebijakan Privasi</a></strong> — Informasi lengkap tentang bagaimana kami mengumpulkan, menggunakan, dan melindungi data pribadi Anda.</li>
								<li><strong><a href="/purchase-policy" class="text-accent hover:underline">Kebijakan Pembelian</a></strong> — Rincian tentang harga, metode pembayaran, proses transaksi, dan kebijakan pengembalian dana.</li>
							</ul>
						</div>
					</div>
				</div>

				<div class="card card-hover p-8 fade-in-up" style="animation-delay:0.16s;">
					<div class="flex items-start gap-4">
						<div class="w-12 h-12 rounded-2xl bg-[var(--warm-100)] flex items-center justify-center flex-shrink-0">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--warm-500)]"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
						</div>
						<div>
							<h3 class="text-lg font-bold text-[var(--textMain)] m-0">Topik Bantuan</h3>
							<p class="mt-2 text-sm text-[var(--textMuted)] leading-relaxed m-0">
								Kami siap membantu Anda dengan berbagai topik, termasuk:
							</p>
							<div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-3">
								<div class="p-3 rounded-xl bg-[var(--bgSection)] border border-[var(--bordLight)]">
									<p class="text-sm font-semibold text-[var(--textMain)] m-0">Tes & Teknis</p>
									<ul class="mt-1 text-xs text-[var(--textMuted)] space-y-0.5 list-disc pl-4">
										<li>Cara memulai tes IQ</li>
										<li>Masalah tampilan soal</li>
										<li>Timer atau progress error</li>
										<li>Sesi tes terputus</li>
										<li>Kompatibilitas browser</li>
									</ul>
								</div>
								<div class="p-3 rounded-xl bg-[var(--bgSection)] border border-[var(--bordLight)]">
									<p class="text-sm font-semibold text-[var(--textMain)] m-0">Pembayaran & Akses</p>
									<ul class="mt-1 text-xs text-[var(--textMuted)] space-y-0.5 list-disc pl-4">
										<li>Metode pembayaran</li>
										<li>Pembayaran tidak terkonfirmasi</li>
										<li>Tautan hasil tidak diterima</li>
										<li>Permintaan refund</li>
										<li>Pembayaran duplikat</li>
									</ul>
								</div>
								<div class="p-3 rounded-xl bg-[var(--bgSection)] border border-[var(--bordLight)]">
									<p class="text-sm font-semibold text-[var(--textMain)] m-0">Akun & Data</p>
									<ul class="mt-1 text-xs text-[var(--textMuted)] space-y-0.5 list-disc pl-4">
										<li>Permintaan akses data</li>
										<li>Koreksi data pribadi</li>
										<li>Penghapusan data</li>
										<li>Unsubscribe newsletter</li>
										<li>Pertanyaan privasi</li>
									</ul>
								</div>
								<div class="p-3 rounded-xl bg-[var(--bgSection)] border border-[var(--bordLight)]">
									<p class="text-sm font-semibold text-[var(--textMain)] m-0">Umpan Balik</p>
									<ul class="mt-1 text-xs text-[var(--textMuted)] space-y-0.5 list-disc pl-4">
										<li>Saran perbaikan</li>
										<li>Laporan bug</li>
										<li>Kemitraan & kerjasama</li>
										<li>Pertanyaan media</li>
										<li>Masukan umum</li>
									</ul>
								</div>
							</div>
						</div>
					</div>
				</div>

				<div class="card card-hover p-8 fade-in-up" style="animation-delay:0.24s;">
					<div class="flex items-start gap-4">
						<div class="w-12 h-12 rounded-2xl bg-[var(--brand-100)] flex items-center justify-center flex-shrink-0">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--brand-500)]"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
						</div>
						<div>
							<h3 class="text-lg font-bold text-[var(--textMain)] m-0">Media Sosial</h3>
							<p class="mt-2 text-sm text-[var(--textMuted)] leading-relaxed m-0">
								Ikuti kami di media sosial untuk mendapatkan pembaruan, tips pengembangan kognitif, informasi tentang fitur baru, dan konten menarik seputar dunia tes IQ dan psikometri:
							</p>
							<div class="flex flex-wrap gap-4 mt-3">
								<a href="#" class="flex items-center gap-2.5 px-4 py-2.5 rounded-xl border border-[var(--bordLight)] text-sm text-[var(--textMuted)] hover:text-accent hover:border-[var(--accent-200)] hover:bg-[var(--accent-50)] transition-all duration-200">
									<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"/></svg>
									Twitter / X
								</a>
								<a href="#" class="flex items-center gap-2.5 px-4 py-2.5 rounded-xl border border-[var(--bordLight)] text-sm text-[var(--textMuted)] hover:text-accent hover:border-[var(--accent-200)] hover:bg-[var(--accent-50)] transition-all duration-200">
									<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
									Instagram
								</a>
								<a href="#" class="flex items-center gap-2.5 px-4 py-2.5 rounded-xl border border-[var(--bordLight)] text-sm text-[var(--textMuted)] hover:text-accent hover:border-[var(--accent-200)] hover:bg-[var(--accent-50)] transition-all duration-200">
									<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
									LinkedIn
								</a>
							</div>
						</div>
					</div>
				</div>

				<div class="card card-hover p-8 fade-in-up" style="animation-delay:0.32s;">
					<div class="flex items-start gap-4">
						<div class="w-12 h-12 rounded-2xl bg-[var(--accent-50)] flex items-center justify-center flex-shrink-0">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--accent-500)]"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
						</div>
						<div>
							<h3 class="text-lg font-bold text-[var(--textMain)] m-0">Jam Operasional</h3>
							<p class="mt-2 text-sm text-[var(--textMuted)] leading-relaxed m-0">
								Tim dukungan IQ Test tersedia pada jam kerja berikut:
							</p>
							<ul class="mt-2 text-sm text-[var(--textMuted)] leading-relaxed space-y-1 list-disc pl-5">
								<li><strong>Hari:</strong> Senin – Jumat</li>
								<li><strong>Jam:</strong> 09.00 – 17.00 WIB (Waktu Indonesia Barat)</li>
								<li><strong>Waktu Respons:</strong> 1×24 jam pada hari kerja</li>
								<li><strong>Akhir Pekan & Hari Libur Nasional:</strong> Email akan direspons pada hari kerja berikutnya</li>
							</ul>
							<p class="mt-2 text-sm text-[var(--textMuted)] leading-relaxed m-0">
								Untuk pertanyaan mendesak di luar jam kerja, kami akan memprioritaskan respons di awal jam kerja berikutnya. Platform tetap beroperasi 24/7 — Anda dapat mengerjakan tes dan melakukan pembayaran kapan saja.
							</p>
						</div>
					</div>
				</div>
			</div>

			<div class="text-center mt-10 pt-6 border-t border-[var(--bordLight)]">
				<p class="text-sm text-[var(--textMuted)]">
					Butuh bantuan segera? <a href="mailto:support@iqtest.id" class="text-accent font-semibold hover:underline">Kirim email langsung</a> — kami siap membantu!
				</p>
			</div>
			</div>
		</div>
	</section>
}
