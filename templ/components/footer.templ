package components

templ Footer() {
	<footer class="footer" role="contentinfo">
		<div class="footer-bg-symbol" aria-hidden="true">
			<svg width="24" height="24" viewBox="0 0 24 24" fill="none"
				stroke="white" stroke-width="1.5"
				stroke-linecap="round" stroke-linejoin="round">
				<path d="m10.852 14.772-.383.923"/>
				<path d="m10.852 9.228-.383-.923"/>
				<path d="m13.148 14.772.382.924"/>
				<path d="m13.531 8.305-.383.923"/>
				<path d="m14.772 10.852.923-.383"/>
				<path d="m14.772 13.148.923.383"/>
				<path d="M17.598 6.5A3 3 0 1 0 12 5a3 3 0 0 0-5.63-1.446 3 3 0 0 0-.368 1.571 4 4 0 0 0-2.525 5.771"/>
				<path d="M17.998 5.125a4 4 0 0 1 2.525 5.771"/>
				<path d="M19.505 10.294a4 4 0 0 1-1.5 7.706"/>
				<path d="M4.032 17.483A4 4 0 0 0 11.464 20c.18-.311.892-.311 1.072 0a4 4 0 0 0 7.432-2.516"/>
				<path d="M4.5 10.291A4 4 0 0 0 6 18"/>
				<path d="M6.002 5.125a3 3 0 0 0 .4 1.375"/>
				<path d="m9.228 10.852-.923-.383"/>
				<path d="m9.228 13.148-.923.383"/>
				<circle cx="12" cy="12" r="3"/>
			</svg>
		</div>
		<div class="container footer-inner">
			<div class="footer-grid">
				<!-- Logo + tagline (col 1) -->
				<div class="footer-brand">
					<a href="/" class="footer-logo">
				<span class="footer-logo-icon" aria-hidden="true">
					<svg width="24" height="24" viewBox="0 0 24 24" fill="none"
						stroke="white" stroke-width="1.5"
						stroke-linecap="round" stroke-linejoin="round">
						<path d="m10.852 14.772-.383.923"/>
						<path d="m10.852 9.228-.383-.923"/>
						<path d="m13.148 14.772.382.924"/>
						<path d="m13.531 8.305-.383.923"/>
						<path d="m14.772 10.852.923-.383"/>
						<path d="m14.772 13.148.923.383"/>
						<path d="M17.598 6.5A3 3 0 1 0 12 5a3 3 0 0 0-5.63-1.446 3 3 0 0 0-.368 1.571 4 4 0 0 0-2.525 5.771"/>
						<path d="M17.998 5.125a4 4 0 0 1 2.525 5.771"/>
						<path d="M19.505 10.294a4 4 0 0 1-1.5 7.706"/>
						<path d="M4.032 17.483A4 4 0 0 0 11.464 20c.18-.311.892-.311 1.072 0a4 4 0 0 0 7.432-2.516"/>
						<path d="M4.5 10.291A4 4 0 0 0 6 18"/>
						<path d="M6.002 5.125a3 3 0 0 0 .4 1.375"/>
						<path d="m9.228 10.852-.923-.383"/>
						<path d="m9.228 13.148-.923.383"/>
						<circle cx="12" cy="12" r="3"/>
					</svg>
				</span>
				IQ Test
					</a>
			<p class="footer-tagline">
				Ukur kemampuan kognitifmu melalui tes IQ bergambar 20 soal yang reflektif dan ilmiah.
			</p>
				</div>

				<!-- Navigasi, Informasi, Sumber Daya (col 2-4) -->
				<div class="footer-links-grid">
					// <div>
					// 	<p class="footer-heading">Navigasi</p>
					// 	<ul class="footer-links">
					// 		<li><a href="/" class="footer-link">Beranda</a></li>
					// 		<li><a href="/#features" class="footer-link">Fitur</a></li>
					// 		<li><a href="/quiz" class="footer-link">Mulai Tes</a></li>
					// 	</ul>
					// </div>

					<div>
						<p class="footer-heading">Legal</p>
						<ul class="footer-links">
							<li><a href="/privacy" class="footer-link">Privasi</a></li>
							<li><a href="/terms" class="footer-link">Syarat & Ketentuan</a></li>
							<li><a href="/purchase-policy" class="footer-link">Kebijakan Pembelian</a></li>
						</ul>
					</div>
	
					<div>
						<p class="footer-heading">Informasi</p>
						<ul class="footer-links">
							<li><a href="/tentang" class="footer-link">Tentang Kami</a></li>
							<li><a href="/faq" class="footer-link">FAQ</a></li>
							<li><a href="/contact" class="footer-link">Kontak</a></li>
						</ul>
					</div>

					<div>
