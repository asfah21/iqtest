package components

templ QuizHeader() {
	<!-- Quiz Header Container (per QUIZ_HEADER.md) -->
	<div class="quiz-header" role="banner">

		<!-- 1. Info Tes (Left Section) -->
		<div class="quiz-header-brand">
			<div class="quiz-header-icon">
				<svg width="24" height="24" viewBox="0 0 24 24" fill="none"
					stroke="white" stroke-width="1.5"
					stroke-linecap="round" stroke-linejoin="round">
					<path d="M12 2a3 3 0 0 0-3 3v1H8a2 2 0 0 0-2 2v3a6 6 0 0 0 12 0V8a2 2 0 0 0-2-2h-1V5a3 3 0 0 0-3-3z"/>
					<path d="M9 18h6"/>
					<path d="M10 22h4"/>
				</svg>
			</div>

			<div class="quiz-header-title">
				<h2>IQ Test</h2>
				<p>Ukur kemampuan kognitifmu</p>
			</div>
		</div>

		<!-- 2. Progress Tes (Center-Left Section) -->
		<div class="quiz-header-progress">
			<span class="quiz-progress-label">Progress Tes</span>
			<div class="quiz-progress-row">
				<div class="quiz-progress-bar">
					<div
						class="quiz-progress-fill"
						:style="'width:' + (((currentQuestion + 1) / questions.length) * 100) + '%'"
					></div>
				</div>
				<span class="quiz-progress-counter">
					<span x-text="currentQuestion + 1"></span>
					/
					<span x-text="questions.length"></span>
				</span>
			</div>
		</div>

		<!-- 3. Waktu Tersisa (Center-Right Section) -->
		<div
			class="quiz-timer-card"
			aria-live="polite"
			aria-atomic="true"
			:aria-label="'Sisa waktu: ' + Math.floor(totalTimeRemaining / 60) + ' menit ' + (totalTimeRemaining % 60) + ' detik'"
		>
			<div class="quiz-timer-icon">
				<svg width="16" height="16" viewBox="0 0 24 24"
					fill="none"
					stroke="#5B4FE0"
					stroke-width="2.5"
					stroke-linecap="round"
					stroke-linejoin="round">
					<circle cx="12" cy="12" r="10"/>
					<polyline points="12 6 12 12 16 14"/>
				</svg>
			</div>
			<div class="quiz-timer-text">
				<small>Waktu Tersisa</small>
				<strong>
					<span x-text="Math.floor(totalTimeRemaining / 60).toString().padStart(2,'0')"></span>:<span x-text="(totalTimeRemaining % 60).toString().padStart(2,'0')"></span>
				</strong>
			</div>
		</div>

		<!-- 4. Tombol Aksi (Right Section) -->
		<button
			type="button"
			class="quiz-end-btn"
			@click="finishQuiz()"
		>
			<svg width="16" height="16" viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round">
				<path d="M5 3v18"/>
				<path d="M5 4h10l-2 4 2 4H5"/>
			</svg>
			<span>Akhiri Tes</span>
		</button>

	</div>
}