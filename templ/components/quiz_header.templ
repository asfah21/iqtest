package components

templ QuizHeader() {
	<!-- Quiz Header Container (per QUIZ_HEADER.md) -->
	<div class="quiz-header" role="banner">

		<!-- 1. Info Tes (Left Section) -->
		<div class="quiz-header-brand">
			<div class="quiz-header-icon">
				<svg width="24" height="24" viewBox="0 0 24 24" fill="none"
					stroke="white" stroke-width="1.5"
					stroke-linecap="round" stroke-linejoin="round">
					<path d="m10.852 14.772-.383.923"/>
					<path d="m10.852 9.228-.383-.923"/>
					<path d="m13.148 14.772.382.924"/>
					<path d="m13.531 8.305-.383.923"/>
					<path d="m14.772 10.852.923-.383"/>
					<path d="m14.772 13.148.923.383"/>
					<path d="M17.598 6.5A3 3 0 1 0 12 5a3 3 0 0 0-5.63-1.446 3 3 0 0 0-.368 1.571 4 4 0 0 0-2.525 5.771"/>
					<path d="M17.998 5.125a4 4 0 0 1 2.525 5.771"/>
					<path d="M19.505 10.294a4 4 0 0 1-1.5 7.706"/>
					<path d="M4.032 17.483A4 4 0 0 0 11.464 20c.18-.311.892-.311 1.072 0a4 4 0 0 0 7.432-2.516"/>
					<path d="M4.5 10.291A4 4 0 0 0 6 18"/>
					<path d="M6.002 5.125a3 3 0 0 0 .4 1.375"/>
					<path d="m9.228 10.852-.923-.383"/>
					<path d="m9.228 13.148-.923.383"/>
					<circle cx="12" cy="12" r="3"/>
				</svg>
			</div>

			<div class="quiz-header-title">
				<h2>IQ Test</h2>
				// <p>Ukur kemampuan kognitifmu</p>
			</div>
		</div>

		<!-- 2. Progress Tes (Center-Left Section) -->
		<div class="quiz-header-progress">
			<span class="quiz-progress-label">Progress Tes</span>
			<div class="quiz-progress-row">
				<div class="quiz-progress-bar">
					<div
						class="quiz-progress-fill"
						:style="'width:' + (((currentQuestion + 1) / questions.length) * 100) + '%'"
					></div>
				</div>
				<span class="quiz-progress-counter">
					<span x-text="currentQuestion + 1"></span>
					/
					<span x-text="questions.length"></span>
				</span>
			</div>
		</div>

		<!-- 3+4. Timer & Tombol Aksi (Right Section, grouped) -->
		<div class="quiz-header-actions">
			<div
				class="quiz-timer-card"
				aria-live="polite"
				aria-atomic="true"
				:aria-label="'Sisa waktu: ' + Math.floor(totalTimeRemaining / 60) + ' menit ' + (totalTimeRemaining % 60) + ' detik'"
			>
				<div class="quiz-timer-icon">
					<svg width="16" height="16" viewBox="0 0 24 24"
						fill="none"
						stroke="#5B4FE0"
						stroke-width="2.5"
						stroke-linecap="round"
						stroke-linejoin="round">
						<circle cx="12" cy="12" r="10"/>
						<polyline points="12 6 12 12 16 14"/>
					</svg>
				</div>
				<div class="quiz-timer-text">
					// <small>Waktu Tersisa</small>
					<strong>
						<span x-text="Math.floor(totalTimeRemaining / 60).toString().padStart(2,'0')"></span>:<span x-text="(totalTimeRemaining % 60).toString().padStart(2,'0')"></span>
					</strong>
				</div>
			</div>

			<button
				type="button"
				class="quiz-end-btn"
				@click="finishQuiz()"
			>
				<svg width="16" height="16" viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round">
					<path d="M5 3v18"/>
					<path d="M5 4h10l-2 4 2 4H5"/>
				</svg>
				<span>Akhiri Tes</span>
			</button>
		</div>

	</div>
}